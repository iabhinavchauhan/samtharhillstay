PORT=5000
JWT_SECRET=super-secret-samthar-jwt-token-key-2026-production
ADMIN_PASSWORD=admin123
MONGODB_URI=mongodb://localhost:27017/samthar_db
RAZORPAY_KEY_ID=rzp_test_samthar_public
RAZORPAY_KEY_SECRET=testsecret

# --- Razorpay ---------------------------------------------------------------
# The values above are placeholders. While they are in place the server runs in
# sandbox checkout mode and the admin panel shows "Payments & Gateway".
# To enable live Razorpay checkout, replace the two values above with the test
# keys from Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key:
#
#   RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
#   RAZORPAY_KEY_SECRET=<your 32-character key secret>
#
# Saving this file reloads the configuration automatically - no restart needed.
# Then use "Verify stored credentials" in Admin -> Payments & Gateway.
